#version 450
#ifndef TILE
#define TILE 8
#endif
layout(local_size_x=TILE,local_size_y=TILE) in;
layout(set=0,binding=0,std430) readonly buffer Inputs {float x[];};
layout(set=0,binding=1,std430) readonly buffer Weights {float w[];};
layout(set=0,binding=2,std430) buffer Queries {float q[];};
layout(set=0,binding=3,std430) buffer Keys {float k[];};
layout(set=0,binding=4,std430) buffer Values {float v[];};
layout(push_constant) uniform Shape {uint n;uint d;uint batch;uint first;uint rows;} s;
shared float a[TILE][TILE];
shared float z[TILE][TILE];
void main() {
    uint lx=gl_LocalInvocationID.x,ly=gl_LocalInvocationID.y;
    uint row=s.first+gl_WorkGroupID.y*TILE+ly,col=gl_WorkGroupID.x*TILE+lx;
    uint b=gl_WorkGroupID.z/3,part=gl_WorkGroupID.z%3;
    float total=0;
    for(uint base=0;base<s.d;base+=TILE) {
        a[ly][lx]=(row<s.first+s.rows && base+lx<s.d)?x[(b*s.n+row)*s.d+base+lx]:0;
        z[ly][lx]=(base+ly<s.d && col<s.d)?w[part*s.d*s.d+(base+ly)*s.d+col]:0;
        barrier();
        for(uint j=0;j<TILE;j++) total+=a[ly][j]*z[j][lx];
        barrier();
    }
    if(row<s.first+s.rows && col<s.d) {
        uint i=(b*s.n+row)*s.d+col;
        if(part==0) q[i]=total; else if(part==1) k[i]=total; else v[i]=total;
    }
}
