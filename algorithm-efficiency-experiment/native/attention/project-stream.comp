#version 450
#ifndef GROUP
#define GROUP 32
#endif
layout(local_size_x=GROUP) in;
layout(push_constant) uniform Shape {uint n;uint d;uint batch;uint first;uint rows;} s;
layout(set=0,binding=0,std430) readonly buffer Inputs {float x[];};
layout(set=0,binding=1,std430) readonly buffer Weights {float w[];};
layout(set=0,binding=2,std430) buffer Queries {float q[];};
layout(set=0,binding=3,std430) buffer Keys {float k[];};
layout(set=0,binding=4,std430) buffer Values {float v[];};
void main(){
    uint col=gl_GlobalInvocationID.x,b=gl_WorkGroupID.z/3,part=gl_WorkGroupID.z%3;
    if(col>=s.d)return;
    uint base=(b*s.n+s.first)*s.d;float total=0;
    for(uint j=0;j<s.d;j++)total+=x[base+j]*w[part*s.d*s.d+j*s.d+col];
    if(part==0)q[base+col]=total;else if(part==1)k[base+col]=total;else v[base+col]=total;
}
